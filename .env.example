APP_NAME="Veyora Media Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Local media processing: configure only after the render stage exists.
MEDIA_WORKER_PYTHON=python3
MEDIA_FFMPEG=ffmpeg
MEDIA_RENDER_ENABLED=false

# Publishing is deliberately disabled until OAuth + permissions are tested.
PUBLISHING_ENABLED=false
# Never commit provider tokens or OAuth credentials.
